mkdir /etc/wetty
rm -f /etc/securetty
sed -i '/master-1/s/$/ px-training/' /etc/hosts
kubectl rollout status deployment/aws-load-balancer-controller -n kube-system --timeout=300s
sed "s/CERT/$training_cert/g; s/KEY/$training_key/g; s/NAME/$name/g; s/DOMAIN/$ocp4_domain/g;" /assets/wetty.tmpl | kubectl apply -f -

TOKEN=$(curl -s -X PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 120')
IP=$(curl -H "X-aws-ec2-metadata-token: $TOKEN" -s http://169.254.169.254/latest/meta-data/public-ipv4)
ZONE_ID=$(aws route53 list-hosted-zones --query "HostedZones[?Name=='$ocp4_domain.'].Id" --output text | cut -d/ -f3)
aws route53 change-resource-record-sets --hosted-zone-id "$ZONE_ID" --change-batch "{\"Changes\":[{\"Action\":\"UPSERT\",\"ResourceRecordSet\":{\"Name\":\"$name-ssh.$ocp4_domain.\",\"Type\":\"A\",\"TTL\":300,\"ResourceRecords\":[{\"Value\":\"$IP\"}]}}]}"

cat <<\EOF >/px-deploy/script-delete/wetty.sh
#!/usr/bin/bash
set -e

kubectl delete svc -n wetty wetty

DOMAIN="__DOMAIN__".
NAME="__NAME__"

ZONE_ID=$(aws route53 list-hosted-zones \
  | jq -r --arg d "$DOMAIN" '.HostedZones[] | select(.Name==$d) | .Id' \
  | sed 's#.*/##')

[[ -z "$ZONE_ID" ]] && { echo "Hosted zone not found"; exit 1; }

CHANGES=$(aws route53 list-resource-record-sets --hosted-zone-id "$ZONE_ID" \
  | jq --arg pat "^(cname-)?$NAME-(wetty|ssh)\.$DOMAIN" '
    .ResourceRecordSets
    | map(select(.Name | test($pat)))
    | map({Action:"DELETE",ResourceRecordSet:.})
  ')

COUNT=$(jq length <<<"$CHANGES")

[[ "$COUNT" -eq 0 ]] && exit 0

aws route53 change-resource-record-sets \
  --hosted-zone-id "$ZONE_ID" \
  --change-batch "{\"Changes\":$CHANGES}"
EOF
sed -i "s/__DOMAIN__/$ocp4_domain/" /px-deploy/script-delete/wetty.sh
sed -i "s/__NAME__/$name/" /px-deploy/script-delete/wetty.sh
